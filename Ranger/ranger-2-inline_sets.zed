\subsubsection{Input Triggers}

\begin{circusaction}
	InputTriggers \circdef obstacle\_InputEventMapping 
\end{circusaction}


% When the distance from the robot to an obstacle is less than 0.5 m, the event obstacle occurs.
\begin{circusaction}
	obstacle\_InputEventMapping \circdef \\
	\t1 \circif (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5 - eps)) \circthen {} \\
	\t3 obstacleTriggered!\true \\
	\t3 {} \then obstacleOccurred, obstacleTime := \true, time \\
	\t1 {} \circelse \lnot (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5)) \circthen {} \\
	\t3 obstacleTriggered!\false \then \Skip \\
	\t1 {} \circelse \lnot (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5 - eps)) \\
	\t2 {} \land (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5)) \circthen {} \\
	\t3 \Skip \\
	\t1 \circfi
\end{circusaction}

\subsubsection{Communication with Mapping Definitions}

\begin{circusaction}
	Communication \circdef \\
	\circblockbegin
	\circblockbegin
	GetRobotPosition \extchoice GetRobotVelocity \extchoice GetRobotAcceleration \\
	{} \extchoice {} \\
	GetRobotOrientation \extchoice GetRobotAngularVelocity \extchoice GetRobotAngularAcceleration \\
	{} \extchoice {} \\
	SetRobotPosition \extchoice SetRobotVelocity \extchoice SetRobotAcceleration \\
	{} \extchoice {} \\
	SetRobotOrientation \extchoice SetRobotAngularVelocity \extchoice SetRobotAngularAcceleration \\
	{} \extchoice {} \\
	GetObstacles \extchoice GetObstaclePosition \extchoice GetObstacleOrientation
	\circblockend \circseq \\
	Communication \\
	\circblockend \\
	{} \extchoice proceed \then \Skip 
\end{circusaction}

\begin{circusaction}
	GetRobotPosition \circdef \\
	\t1 getRobotPosition!(robot.position) \then \Skip \\
	GetRobotVelocity \circdef \\
	\t1 getRobotVelocity!(robot.velocity) \then \Skip \\
	GetRobotAcceleration \circdef \\
	\t1 getRobotAcceleration!(robot.acceleration) \then \Skip \\
	GetRobotOrientation \circdef \\
	\t1 getRobotOrientation!(robot.orientation) \then \Skip \\
	GetRobotAngularVelocity \circdef \\
	\t1 getRobotAngularVelocity!(robot.angularVelocity) \then \Skip \\
	GetRobotAngularAcceleration \circdef \\
	\t1 getRobotAngularAcceleration!(robot.angularAcceleration) \then \Skip \\
\end{circusaction}
\circtoolsoff
\begin{circusaction}
	SetRobotPosition \circdef \\
	\t1 setRobotPosition?x \then robot.position := x \\
	SetRobotVelocity \circdef \\
	\t1 setRobotVelocity?x \then robot.velocity := x \\
	SetRobotAcceleration \circdef \\
	\t1 setRobotAcceleration?x \then robot.acceleration := x \\
	SetRobotOrientation \circdef \\
	\t1 setRobotOrientation?x \then robot.orientation := x  \\
	SetRobotAngularVelocity \circdef \\
	\t1 setRobotAngularVelocity?x \then robot.angularVelocity := x  \\
	SetRobotAngularAcceleration \circdef \\
	\t1 setRobotAngularAcceleration?x \then robot.angularAcceleration := x 
\end{circusaction}
\circtoolson
\begin{comment}
\begin{circusaction}
	SetRobotPosition \circdef \\
	\t1 setRobotPosition?x \then \Skip \\
	SetRobotVelocity \circdef \\
	\t1 setRobotVelocity?x \then \Skip \\
	SetRobotAcceleration \circdef \\
	\t1 setRobotAcceleration?x \then \Skip \\
	SetRobotOrientation \circdef \\
	\t1 setRobotOrientation?x \then \Skip  \\
	SetRobotAngularVelocity \circdef \\
	\t1 setRobotAngularVelocity?x \then \Skip  \\
	SetRobotAngularAcceleration \circdef \\
	\t1 setRobotAngularAcceleration?x \then \Skip
\end{circusaction}
\end{comment}

\begin{circusaction}
	GetObstacles \circdef \\
	\t1 getMaxObstacleID!(numObstacles) \then \Skip \\
	GetObstaclePosition \circdef \\
	\t1 getObstaclePosition?o!((obstacles~o).position) \then \Skip \\
	GetObstacleOrientation \circdef \\
	\t1 getObstacleOrientation?o!((obstacles~o).orientation) \then \Skip
\end{circusaction}

\begin{circusaction}
	CheckTock \circdef \\
	\t1 \circif tockTimer \geq tockLength - eps \circthen tock \then tockTimer := 0\decimalpoint0 \\
	\t1 {} \circelse tockTimer < tockLength - eps \circthen \Skip \\
	\t1 \circfi
\end{circusaction}

\subsubsection{Input Event Buffers}

\begin{circusaction}
	InputEventBuffers \circdef obstacle\_Buffer
\end{circusaction}

\begin{circusaction}
	obstacle\_Buffer \circdef \circvar obstacleTrig : \boolean \circspot obstacleTrig := \false \circseq \\ 
		\t1 \circmu X \circspot \circblockbegin
			obstacleTriggered?b \then obstacleTrig := b \\
			{} \extchoice {} \\
			\lcircguard obstacleTrig = \true \rcircguard \circguard obstacle.in \then \Skip
		\circblockend \circseq X
\end{circusaction}
