\begin{comment}
\begin{zsection}
  \SECTION ranger \parents roboworld\_2d\_toolkit
\end{zsection}
\end{comment}

\begin{axdef}
	eps : \real
\end{axdef}

\subsection{Types}

% The arena is two-dimensional.
\begin{zed}
	Position ~==~ \real \cross \real \\
	Velocity ~==~ \real \cross \real \\
	Acceleration ~==~ \real \cross \real \\
	Orientation ~==~ \real \\
	AngularVelocity ~==~ \real \\
	AngularAcceleration ~==~ \real
\end{zed}

\begin{schema}{ArenaProperty}
	% The arena is two-dimensional.
	xwidth, ywidth : \real \\
	gradient, windSpeed : \real \\
	locations : \power Position
\where
	% The arena is two-dimensional.
	locations = \{ x : 0 \upto xwidth; y : 0 \upto ywidth \}
\end{schema}

% The robot is a point mass.
\begin{schema}{RobotProperty}
	position : Position \\
	velocity : Velocity \\
	acceleration : Acceleration \\
	orientation : Orientation \\
	angularVelocity : AngularVelocity \\
	angularAcceleration : AngularAcceleration
\end{schema}

% The arena has obstacles.
\begin{axdef}
	numObstacles : \nat
\end{axdef}
\begin{zed}
	ObstacleID == 1 \upto numObstacles
\end{zed}
\begin{schema}{ObstacleProperty}
	% The obstacles are circles.
	radius : \real \\
	position : Position \\
	orientation : Orientation \\
	locations : \power Position
\where
	% The obstacles are circles.
	locations = circleLocs~position~orientation~radius
\end{schema}

\subsection{Channels}

\subsubsection{Software channels}

\begin{zed}
	InOut ::= in | out
\end{zed}
\begin{circus}
	\circchannel obstacle : InOut \\
	\circchannel moveCall : \real \cross \real
\end{circus}

\begin{circus}
	\circchannel tock
\end{circus}
\begin{axdef}
	tockLength : \real
\end{axdef}

\subsubsection{Input event triggered channels}

\begin{circus}
	\circchannel obstacleTriggered : \boolean
\end{circus}

\subsubsection{Output clock reset channels}

\begin{circus}
	\circchannel moveHappened
\end{circus}

\subsubsection{Variable get/set channels}

\begin{circus}
	\circchannel getRobotPosition : Position \\
	\circchannel getRobotVelocity : Velocity \\
	\circchannel getRobotAcceleration : Acceleration \\
	\circchannel getRobotOrientation : Orientation \\
	\circchannel getRobotAngularVelocity : AngularVelocity \\
	\circchannel getRobotAngularAcceleration : AngularAcceleration \\
	\circchannel setRobotPosition : Position \\
	\circchannel setRobotVelocity : Velocity \\
	\circchannel setRobotAcceleration : Acceleration \\
	\circchannel setRobotOrientation : Orientation \\
	\circchannel setRobotAngularVelocity : AngularVelocity \\
	\circchannel setRobotAngularAcceleration : AngularAcceleration
\end{circus}

\begin{circus}
	\circchannel getMaxObstacleID : ObstacleID \\
	\circchannel getObstaclePosition : ObstacleID \cross Position \\
	\circchannel getObstacleOrientation : ObstacleID \cross Orientation
\end{circus}

\begin{circus}
	\circchannel proceed
\end{circus}

\subsection{Global Constants}

\begin{axdef}
	arena : ArenaProperty \\ % arena is a region, so is static
	obstacles : \seq ObstacleProperty % obstacles are multiple and static
\end{axdef}

% The arena has a floor.
% no need for ground locations set in 2d

\begin{axdef}
\where
	arena.gradient = 0\decimalpoint0 % The gradient of the ground is 0.0.
\end{axdef}

\begin{axdef}
\where
	\# obstacles \geq 2 \\ % The arena has at least 2 obstacles.
	\forall obstacle : \ran obstacles @ obstacle.locations \subseteq arena.locations
\end{axdef}

\subsection{Environment}

\begin{axdef}
	timeStep : \real
\end{axdef}

\begin{circus}
	\circprocess Environment \circdef \circbegin
\end{circus}

\subsubsection{Environment State}

\begin{schema}{EventTimes}
	obstacleTime : \real \\
	obstacleOccurred : \boolean
	\also
	moveTime : \real \\
	moveOccurred : \boolean
\end{schema}
\begin{schema}{EventTimesInit}
	EventTimes~'
\where
	obstacleTime' = 0\decimalpoint0 \\
	obstacleOccurred' = \false
	\also
	moveTime' = 0\decimalpoint0 \\
	moveOccurred' = \false
\end{schema}

\circtoolsoff
\begin{schema}{EnvironmentStateVars}
	\mathbf{visible}\; robot : RobotProperty \\
	time : \real \\
	stepTimer : \real \\
	tockTimer : \real \\
	EventTimes
\where
	robot.position \in arena.locations
\end{schema}
\circtoolson
\begin{comment}
\begin{schema}{EnvironmentStateVars}
	robot : RobotProperty \\
	time : \real \\
	stepTimer : \real \\
	tockTimer : \real \\
	EventTimes
\end{schema}
\end{comment}

\begin{schema}{RobotAssumptions}
	EnvironmentStateVars
\where
	robot.position \in arena.locations
\end{schema}

\begin{schema}{RobotCollisionAssumptions}
	EnvironmentStateVars
\where
	\forall obstacle : \ran obstacles @ robot.position \notin obstacle.locations
\end{schema}

\begin{schema}{EnvironmentState}
	EnvironmentStateVars \\
	inarg1 : \real \cross \real \\
	inarg2 : \real \cross \real \\
	inarg3 : \real \cross \real \\
	inarg4 : \real \\
	inarg5 : \real \\
	inarg6 : \real \\
	inarg7 : \nat \\
	inarg8 : \nat \\
	obstacleTrig : \boolean \\
	inarg9 : \boolean
\where
	RobotAssumptions \\
	RobotCollisionAssumptions
\end{schema}
\begin{circusaction}
	\circstate EnvironmentState
\end{circusaction}

\begin{schema}{EnvironmentStateInit}
	EnvironmentState~'
\where
	time' = 0\decimalpoint0 \\
	stepTimer' = 0\decimalpoint0 \\
	tockTimer' = 0\decimalpoint0 \\
	EventTimesInit
\end{schema}

\subsubsection{Robot Movement}

\circtoolsoff
\begin{schema}{RobotMovement}
	\Lambda EnvironmentState
\where
	\derivative{robot.position} = robot.velocity \\
	\derivative{robot.velocity} = robot.acceleration \\
	\derivative{robot.acceleration} = (0,0) \\
	\derivative{robot.orientation} = robot.angularVelocity \\
	\derivative{robot.angularVelocity} = robot.angularAcceleration \\
	\derivative{robot.angularAcceleration} = 0 \\
	\derivative{time} = 1 \\
	\derivative{stepTimer} = 1 \\
	\derivative{tockTimer} = 1
\end{schema}
\circtoolson
\begin{comment}
\begin{schema}{RobotMovement}
	\Delta EnvironmentState
\where
	\derivative{robot.position} = robot.velocity \\
	\derivative{robot.velocity} = robot.acceleration \\
	\derivative{robot.acceleration} = (0,0) \\
	\derivative{robot.orientation} = robot.angularVelocity \\
	\derivative{robot.angularVelocity} = robot.angularAcceleration \\
	\derivative{robot.angularAcceleration} = 0 \\
	\derivative{time} = 1 \\
	\derivative{stepTimer} = 1 \\ 
	\derivative{tockTimer} = 1
\end{schema}
\end{comment}

\begin{zed}
	\relation (robotObstacleCollision \varg)
\end{zed}
\begin{axdef}
	robotObstacleCollision \varg : \power (RobotProperty \cross ObstacleProperty)
\where
	\forall robot : RobotProperty; obstacle : ObstacleProperty @ \\
	\t1 robotObstacleCollision~(robot, obstacle) \iff robot.position \in obstacle.locations
\end{axdef}

\circtoolsoff
\begin{circusaction}
	RobotMovementAction\_1 \circdef \lschexpract RobotMovement \rschexpract \\
	\t1 \circinterrupt \circblockbegin
			% collision between robot and an obstacle
			\exists obstacle : \ran obstacles @ robotObstacleCollision(robot, obstacle) \\
			\t2 {} \land (robot.velocity \vecdotprod (obstacle.position \vecminus robot.position) > 0)) \\
			% timeStep reached
			{} \lor (stepTimer \geq timeStep)
		\circblockend
\end{circusaction}
\circtoolson
\begin{comment}
\begin{circusaction}
	RobotMovementAction\_1 \circdef \lschexpract RobotMovement \rschexpract \circseq
	\lcircguard \circblockbegin
			% collision between robot and an obstacle
			\exists obstacle : \ran obstacles @ robotObstacleCollision(robot, obstacle) \\
			% timeStep reached
			{} \lor (stepTimer \geq timeStep)
		\circblockend \rcircguard \circguard \Skip
\end{circusaction}
\end{comment}

