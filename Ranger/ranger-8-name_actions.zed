%\end{circusaction}

\subsubsection{Output Event Buffers}

\begin{circusaction}
	OutputEventBuffers\_1 \circdef move\_Buffer\_1
\end{circusaction}

\begin{circusaction}
	move\_Buffer\_1 \circdef move\_Buffer\_2 \circseq move\_Buffer\_3 \\
	move\_Buffer\_2 \circdef moveTime, moveOccurred := 0\decimalpoint0, \false \\
	move\_Buffer\_3 \circdef moveHappened \then move\_Buffer\_4 \\
	move\_Buffer\_4 \circdef move\_Buffer\_5 \circseq move\_Buffer\_3 \\
	move\_Buffer\_5 \circdef moveOccurred, moveTime := \true, time
\end{circusaction}

\subsubsection{Environment main action}

\begin{circusaction}
	EventBuffers\_1 \circdef InputEventBuffers\_1 \lpar \emptyset | \emptyset | \{ moveTime, moveOccurred \} \rpar OutputEventBuffers\_1
\end{circusaction}

%time' = 0\decimalpoint0 \\
%stepTimer' = 0\decimalpoint0 \\
%tockTimer' = 0\decimalpoint0 \\
%obstacleTime' = 0\decimalpoint0 \\
%obstacleOccurred' = \false
%moveTime' = 0\decimalpoint0 \\
%moveOccurred' = \false

\begin{circusaction}
	EnvironmentLoop\_1 \circdef EnvironmentLoop\_2 \circseq EnvironmentLoop\_3 \\
	EnvironmentLoop\_2 \circdef time, stepTimer, tockTimer, obstacleTime, obstacleOccurred := 0\decimalpoint0, 0\decimalpoint0, 0\decimalpoint0, 0\decimalpoint0, \false \\
	EnvironmentLoop\_3 \circdef RobotMovementAction\_1 \circseq EnvironmentLoop\_4 \\
	EnvironmentLoop\_4 \circdef EnvironmentLoop\_5 \circseq EnvironmentLoop\_3 \\
	EnvironmentLoop\_5 \circdef \\
	\t1 \circif stepTimer < timeStep - eps \circthen HandleCollision\_1 \\
	\t1 {} \circelse stepTimer \geq timeStep - eps \circthen EnvironmentLoop\_6 \\
	\t1 \circfi \\
	EnvironmentLoop\_6 \circdef InputTriggers\_1 \circseq EnvironmentLoop\_7 \\
	EnvironmentLoop\_7 \circdef Communication\_1 \circseq EnvironmentLoop\_8 \\
	EnvironmentLoop\_8 \circdef CheckTock\_1 \circseq EnvironmentLoop\_9 \\
	EnvironmentLoop\_9 \circdef stepTimer := 0 \\
\end{circusaction}

\begin{circusaction}
	\circspot (EnvironmentLoop\_1 \lpar \{ robot, time, stepTimer, tockTimer, obstacleTime, obstacleOccurred \} | \lchanset obstacleTriggered \rchanset | \{ moveTime, moveOccurred \} \rpar EventBuffers\_1) \\
	\t1 \circhide \lchanset obstacleTriggered \rchanset
\end{circusaction}

\begin{circus}
	\circend
\end{circus}

\subsection{Mapping}

% When the operation move(lv,av) is called,
% 	the velocity of the robot is set to lv m/s in the direction of the orientation of the robot,
% 	and the angular velocity of the robot is set to av rad/s.
\begin{circus}
	\circprocess move\_OperationMapping \circdef \circbegin
\end{circus}

\begin{schema}{Mapping\_State}
	inarg10 : \real \\
	inarg11 : \real \\
	inarg12 : \real \\
	inarg13 : \real \\
	inarg14 : \real
\end{schema}
\begin{circusaction}
	\circstate Mapping\_State
\end{circusaction}

\begin{circusaction}
	move\_Semantics\_1 \circdef \\
	\t1 moveCall?x1?x2 \then inarg10, inarg11 := x1, x2 \circseq move\_Semantics\_2 \\
	\t1 {} \extchoice {} \\
	\t1 proceed \then move\_Semantics\_1 \\
	move\_Semantics\_2 \circdef \\
	\t1 getRobotOrientation?x \then inarg12 := x \circseq move\_Semantics\_3 \\
	move\_Semantics\_3 \circdef move\_Semantics\_4 \circseq move\_Semantics\_5 \\
	move\_Semantics\_4 \circdef setRobotVelocity!(inarg10 \scalarmult orientationToVector~inarg12 ) \then move\_Semantics\_6 \\
	move\_Semantics\_5 \circdef setRobotAngularVelocity!inarg11 \then move\_Semantics\_7 \\
	move\_Semantics\_6 \circdef \Skip \\
	move\_Semantics\_7 \circdef move\_Semantics\_8 \circseq move\_Semantics\_1 \\
	move\_Semantics\_8 \circdef \Skip
\end{circusaction}
\begin{circusaction}
	move\_Monitor\_1 \circdef moveCall?x1?x2 \then inarg13, inarg14 := x1, x2 \circseq move\_Monitor\_2 \\
	move\_Monitor\_2 \circdef moveHappened \then move\_Monitor\_1
\end{circusaction}
\begin{circusaction}
	\circspot move\_Semantics\_1 \lpar \emptyset | \lchanset moveCall \rchanset | \emptyset \rpar move\_Monitor\_1
\end{circusaction}
\begin{circus}
	\circend
\end{circus}

\begin{circus}
	\circprocess Mapping \circdef move\_OperationMapping
\end{circus}

\subsection{Composition}

\begin{circus}
	\circprocess RoboWorldDocument \circdef \\
	\t1 (Environment \lpar \lchanset \\
	\t1 getRobotPosition, getRobotVelocity, getRobotAcceleration, \\
	\t1 getRobotOrientation, getRobotAngularVelocity, getRobotAngularAcceleration, \\
	\t1 setRobotPosition, setRobotVelocity, setRobotAcceleration, \\
	\t1 setRobotOrientation, setRobotAngularVelocity, setRobotAngularAcceleration, \\
	\t1 getMaxObstacleID, getObstaclePosition, getObstacleOrientation, moveHappened, proceed \rchanset \rpar Mapping) \\
	\t2 {} \circhide \lchanset \\
	\t2 getRobotPosition, getRobotVelocity, getRobotAcceleration, \\
	\t2 getRobotOrientation, getRobotAngularVelocity, getRobotAngularAcceleration, \\
	\t2 setRobotPosition, setRobotVelocity, setRobotAcceleration, \\
	\t2 setRobotOrientation, setRobotAngularVelocity, setRobotAngularAcceleration, \\
	\t2 getMaxObstacleID, getObstaclePosition, getObstacleOrientation, moveHappened, proceed \rchanset
\end{circus}
