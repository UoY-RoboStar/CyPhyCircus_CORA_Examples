%\end{circusaction}
\begin{axdef}
	collisionEps : \real
\end{axdef}
%\begin{schema}{HandleCollisionSchema}
%	\Delta EnvironmentState
%\where
%	\exists \Delta RobotProperty | \\
%	\t1 \Xi RobotProperty \hide (position', velocity') @ \\
%	\t1 \exists initVel == velocity \vecminus collisionEps \scalarmult acceleration @ \\
%	\t1 position' = position \vecminus (collisionEps \realdiv 2) \scalarmult  (initVel \vecplus velocity) \land {} \\
%	\t1 velocity' = initVel \land {} \\
%	\t1 \theta RobotProperty = robot \land robot' = \theta RobotProperty~' \\
%	\Xi EnvironmentState \hide (robot')
%\end{schema}
\begin{comment}
\begin{circusaction}
	HandleCollision\_1 \circdef \\
	\lschexpract [ \Delta EnvironmentState | 
	\t1 robot'.position = \\
	\t2 robot.position \vecminus {} \\
	\t3 (collisionEps \realdiv 2) \scalarmult  (2 \scalarmult robot.velocity \vecminus collisionEps \scalarmult robot.acceleration) \land \\
	\t1 robot.velocity = robot.velocity \vecminus collisionEps \scalarmult robot.acceleration ] \rschexpract
\end{circusaction}
\end{comment}
\circtoolsoff
\begin{circusaction}
	HandleCollision\_1 \circdef \\
	\t1 robot.position, robot.velocity := \\
	\t2 robot.position \vecminus {} \\
	\t3 (collisionEps \realdiv 2) \scalarmult  (2 \scalarmult robot.velocity \vecminus collisionEps \scalarmult robot.acceleration), \\
	\t2 robot.velocity \vecminus collisionEps \scalarmult robot.acceleration \\ 
\end{circusaction}
\circtoolson

\subsubsection{Input Triggers}

\begin{circusaction}
	InputTriggers\_1 \circdef obstacle\_InputEventMapping\_1 
\end{circusaction}


% When the distance from the robot to an obstacle is less than 0.5 m, the event obstacle occurs.
\begin{circusaction}
	obstacle\_InputEventMapping\_1 \circdef \\
	\t1 \circif (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5 - eps)) \circthen obstacle\_InputEventMapping\_2 \\
	\t1 {} \circelse \lnot (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5)) \circthen obstacle\_InputEventMapping\_3 \\
	\t1 {} \circelse \lnot (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5 - eps)) \\
	\t2 {} \land (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5)) \circthen obstacle\_InputEventMapping\_4 \\
	\t1 \circfi \\
	obstacle\_InputEventMapping\_2 \circdef \\
	\t1 obstacleTriggered!\true \then obstacle\_InputEventMapping\_5 \\
	obstacle\_InputEventMapping\_3 \circdef obstacleTriggered!\false \then obstacle\_InputEventMapping\_6 \\
	obstacle\_InputEventMapping\_4 \circdef \Skip \\
	obstacle\_InputEventMapping\_5 \circdef obstacleOccurred, obstacleTime := \true, time \\
	obstacle\_InputEventMapping\_6 \circdef \Skip
\end{circusaction}

\subsubsection{Communication with Mapping Definitions}

\circtoolsoff
\begin{circusaction}
	Communication\_1 \circdef \\
	getRobotPosition!(robot.position) \then Communication\_2 \\
	{} \extchoice {} \\
	getRobotVelocity!(robot.velocity) \then Communication\_3 \\
	{} \extchoice {} \\
	getRobotAcceleration!(robot.acceleration) \then Communication\_4 \\
	{} \extchoice {} \\
	getRobotOrientation!(robot.orientation) \then Communication\_5 \\
	{} \extchoice {} \\
	getRobotAngularVelocity!(robot.angularVelocity) \then Communication\_6 \\
	{} \extchoice {} \\
	getRobotAngularAcceleration!(robot.angularAcceleration) \then Communication\_7 \\
	{} \extchoice {} \\
	setRobotPosition?x \then inarg1 := x \circseq Communication\_8 \\
	{} \extchoice {} \\
	setRobotVelocity?x \then inarg2 := x \circseq Communication\_9 \\
	{} \extchoice {} \\
	setRobotAcceleration?x \then inarg3 := x \circseq Communication\_10 \\
	{} \extchoice {} \\
	setRobotOrientation?x \then inarg4 := x \circseq Communication\_11 \\
	{} \extchoice {} \\
	setRobotAngularVelocity?x \then inarg5 := x \circseq Communication\_12 \\
	{} \extchoice {} \\
	setRobotAngularAcceleration?x \then inarg6 := x \circseq Communication\_13 \\
	{} \extchoice {} \\
	getMaxObstacleID!(numObstacles) \then Communication\_14 \\
	{} \extchoice {} \\
	getObstaclePosition?x!((obstacles~x).position) \then inarg7 := x \circseq Communication\_15 \\
	{} \extchoice {} \\
	getObstacleOrientation?x!((obstacles~x).orientation) \then inarg8 := x \circseq Communication\_16 \\
	{} \extchoice {} \\
	proceed \then Communication\_17 \\
	Communication\_2 \circdef Communication\_18 \circseq Communication\_1 \\
	Communication\_3 \circdef Communication\_19 \circseq Communication\_1 \\
	Communication\_4 \circdef Communication\_20 \circseq Communication\_1 \\
	Communication\_5 \circdef Communication\_21 \circseq Communication\_1 \\
	Communication\_6 \circdef Communication\_22 \circseq Communication\_1 \\
	Communication\_7 \circdef Communication\_23 \circseq Communication\_1 \\
	Communication\_8 \circdef Communication\_24 \circseq Communication\_1 \\
	Communication\_9 \circdef Communication\_25 \circseq Communication\_1 \\
	Communication\_10 \circdef Communication\_26 \circseq Communication\_1 \\
	Communication\_11 \circdef Communication\_27 \circseq Communication\_1 \\
	Communication\_12 \circdef Communication\_28 \circseq Communication\_1 \\
	Communication\_13 \circdef Communication\_29 \circseq Communication\_1 \\
	Communication\_14 \circdef Communication\_30 \circseq Communication\_1 \\
	Communication\_15 \circdef Communication\_31 \circseq Communication\_1 \\
	Communication\_16 \circdef Communication\_32 \circseq Communication\_1 \\
	Communication\_17 \circdef \Skip \\
	Communication\_18 \circdef \Skip \\
	Communication\_19 \circdef \Skip \\
	Communication\_20 \circdef \Skip \\
	Communication\_21 \circdef \Skip \\
	Communication\_22 \circdef \Skip \\
	Communication\_23 \circdef \Skip \\
	Communication\_24 \circdef robot.position := inarg1 \\
	Communication\_25 \circdef robot.velocity := inarg2 \\
	Communication\_26 \circdef robot.acceleration := inarg3 \\
	Communication\_27 \circdef robot.orientation := inarg4 \\
	Communication\_28 \circdef robot.angularVelocity := inarg5 \\
	Communication\_29 \circdef robot.angularAcceleration := inarg6 \\
	Communication\_30 \circdef \Skip \\
	Communication\_31 \circdef \Skip \\
	Communication\_32 \circdef \Skip
\end{circusaction}
\circtoolson
