\begin{circusaction}
	CheckTock \circdef \\
	\t1 \circif tockTimer \geq tockLength - eps \circthen tock \then tockTimer := 0\decimalpoint0 \\
	\t1 {} \circelse tockTimer < tockLength - eps \circthen \Skip \\
	\t1 \circfi
\end{circusaction}

\subsubsection{Input Event Buffers}

\begin{circusaction}
	InputEventBuffers \circdef obstacle\_Buffer
\end{circusaction}

\begin{circusaction}
	obstacle\_Buffer \circdef obstacleTrig := \false \circseq \circmu X \circspot \\
	\t1 \circif obstacleTrig = \true \circthen {} \\
	\t2 obstacleTriggered?x \then inarg9 := x \circseq obstacleTrig := inarg9 \circseq X \\
	\t2 {} \extchoice {} \\
	\t2 obstacle.in \then \Skip \circseq X \\
	\t1 {} \circelse obstacleTrig = \true \circthen {} \\
	\t2 obstacleTriggered?x \then inarg9 := x \circseq obstacleTrig := inarg9 \circseq X \\
	\t1 \circfi
\end{circusaction}
