\subsubsection{Input Triggers}

\begin{circusaction}
	InputTriggers \circdef obstacle\_InputEventMapping 
\end{circusaction}


% When the distance from the robot to an obstacle is less than 0.5 m, the event obstacle occurs.
\begin{circusaction}
	obstacle\_InputEventMapping \circdef \\
	\t1 \circif (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5 - eps)) \circthen {} \\
	\t3 obstacleTriggered!\true \\
	\t3 {} \then obstacleOccurred, obstacleTime := \true, time \\
	\t1 {} \circelse \lnot (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5)) \circthen {} \\
	\t3 obstacleTriggered!\false \then \Skip \\
	\t1 {} \circelse \lnot (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5 - eps)) \\
	\t2 {} \land (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5)) \circthen {} \\
	\t3 \Skip \\
	\t1 \circfi
\end{circusaction}

\subsubsection{Communication with Mapping Definitions}

\circtoolsoff
\begin{circusaction}
	Communication \circdef \\
	getRobotPosition!(robot.position) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	getRobotVelocity!(robot.velocity) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	getRobotAcceleration!(robot.acceleration) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	getRobotOrientation!(robot.orientation) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	getRobotAngularVelocity!(robot.angularVelocity) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	getRobotAngularAcceleration!(robot.angularAcceleration) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	setRobotPosition?x \then inarg1 := x \circseq robot.position := inarg1 \circseq Communication \\
	{} \extchoice {} \\
	setRobotVelocity?x \then inarg2 := x \circseq robot.velocity := inarg2 \circseq Communication \\
	{} \extchoice {} \\
	setRobotAcceleration?x \then inarg3 := x \circseq robot.acceleration := inarg3 \circseq Communication \\
	{} \extchoice {} \\
	setRobotOrientation?x \then inarg4 := x \circseq robot.orientation := inarg4 \circseq Communication \\
	{} \extchoice {} \\
	setRobotAngularVelocity?x \then inarg5 := x \circseq robot.angularVelocity := inarg5 \circseq Communication \\
	{} \extchoice {} \\
	setRobotAngularAcceleration?x \then inarg6 := x \circseq robot.angularAcceleration := inarg6 \circseq Communication \\
	{} \extchoice {} \\
	getMaxObstacleID!(numObstacles) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	getObstaclePosition?x!((obstacles~x).position) \then inarg7 := x \circseq \Skip \circseq Communication \\
	{} \extchoice {} \\
	getObstacleOrientation?x!((obstacles~x).orientation) \then inarg8 := x \circseq \Skip \circseq Communication \\
	{} \extchoice {} \\
	proceed \then \Skip 
\end{circusaction}
\circtoolson
\begin{comment}
\begin{circusaction}
	Communication \circdef \\
	getRobotPosition!(robot.position) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	getRobotVelocity!(robot.velocity) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	getRobotAcceleration!(robot.acceleration) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	getRobotOrientation!(robot.orientation) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	getRobotAngularVelocity!(robot.angularVelocity) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	getRobotAngularAcceleration!(robot.angularAcceleration) \then \Skip \circseq Communication \\
	{} \extchoice {} \\
	setRobotPosition?x \then inarg1 := x \circseq inarg1 := inarg1 \circseq Communication \\
	{} \extchoice {} \\
	setRobotVelocity?x \then inarg2 := x \circseq inarg2 := inarg2 \circseq Communication \\
	{} \extchoice {} \\
	setRobotAcceleration?x \then inarg3 := x \circseq inarg3 := inarg3 \circseq Communication \\
	{} \extchoice {} \\
	setRobotOrientation?x \then inarg4 := x \circseq inarg4 := inarg4 \circseq Communication \\
