\subsubsection{Output Event Buffers}

\begin{circusaction}
	OutputEventBuffers \circdef move\_Buffer
\end{circusaction}

\begin{circusaction}
	move\_Buffer \circdef moveTime, moveOccurred := 0\decimalpoint0, \false \circseq\\
	\t1 \circmu X \circspot moveHappened \then moveOccurred, moveTime := \true, time \circseq X
\end{circusaction}

\subsubsection{Environment main action}

\begin{circusaction}
	EventBuffers \circdef InputEventBuffers \lpar \emptyset | \emptyset | \{ moveTime, moveOccurred \} \rpar OutputEventBuffers
\end{circusaction}

%time' = 0\decimalpoint0 \\
%stepTimer' = 0\decimalpoint0 \\
%tockTimer' = 0\decimalpoint0 \\
%obstacleTime' = 0\decimalpoint0 \\
%obstacleOccurred' = \false
%moveTime' = 0\decimalpoint0 \\
%moveOccurred' = \false

\begin{circusaction}
	EnvironmentLoop \circdef \\
	\t1 time, stepTimer, tockTimer, obstacleTime, obstacleOccurred := 0\decimalpoint0, 0\decimalpoint0, 0\decimalpoint0, 0\decimalpoint0, \false \circseq \\
	\t1 \circmu X \circspot RobotMovementAction \circseq \\
	\t1 \circblockbegin 
	\circif stepTimer < timeStep - eps \circthen HandleCollision \\
	{} \circelse stepTimer \geq timeStep - eps \circthen \\
	\t1 InputTriggers \circseq Communication \circseq CheckTock \circseq stepTimer := 0 \\
	\circfi
	\circblockend \circseq X
\end{circusaction}

\begin{circusaction}
	\circspot (EnvironmentLoop \lpar \{ robot, time, stepTimer, tockTimer, obstacleTime, obstacleOccurred \} | \lchanset obstacleTriggered \rchanset | \{ moveTime, moveOccurred \} \rpar EventBuffers) \\
	\t1 \circhide \lchanset obstacleTriggered \rchanset
\end{circusaction}

\begin{circus}
	\circend
\end{circus}

\subsection{Mapping}

% When the operation move(lv,av) is called,
% 	the velocity of the robot is set to lv m/s in the direction of the orientation of the robot,
% 	and the angular velocity of the robot is set to av rad/s.
\begin{circus}
	\circprocess move\_OperationMapping \circdef \circbegin
\end{circus}

\begin{schema}{Mapping\_State}
	inarg10 : \real \\
	inarg11 : \real \\
	inarg12 : \real \\
	inarg13 : \real \\
	inarg14 : \real
\end{schema}
\begin{circusaction}
	\circstate Mapping\_State
\end{circusaction}

\begin{circusaction}
	move\_Semantics \circdef \\
	\t1 moveCall?x1?x2 \then inarg10, inarg11 := x1, x2 \circseq \\
	\t2 getRobotOrientation?x \then inarg12 := x \circseq \\
	\t2 setRobotVelocity!(inarg10 \scalarmult orientationToVector~inarg12 ) \then Skip \circseq \\
	\t2 setRobotAngularVelocity!inarg11 \then \Skip \circseq \\
	\t2 move\_Semantics \\
	\t1 {} \extchoice {} \\
	\t1 proceed \then move\_Semantics
\end{circusaction}
\begin{circusaction}
	move\_Monitor \circdef moveCall?x1?x2 \then inarg13, inarg14 := x1, x2 \circseq moveHappened \then move\_Monitor
\end{circusaction}
\begin{circusaction}
	\circspot move\_Semantics \lpar \emptyset | \lchanset moveCall \rchanset | \emptyset \rpar move\_Monitor
\end{circusaction}
\begin{circus}
	\circend
\end{circus}

\begin{circus}
	\circprocess Mapping \circdef move\_OperationMapping
\end{circus}

\subsection{Composition}

\begin{circus}
	\circprocess RoboWorldDocument \circdef \\
	\t1 (Environment \lpar \lchanset \\
	\t1 getRobotPosition, getRobotVelocity, getRobotAcceleration, \\
	\t1 getRobotOrientation, getRobotAngularVelocity, getRobotAngularAcceleration, \\
	\t1 setRobotPosition, setRobotVelocity, setRobotAcceleration, \\
	\t1 setRobotOrientation, setRobotAngularVelocity, setRobotAngularAcceleration, \\
	\t1 getMaxObstacleID, getObstaclePosition, getObstacleOrientation, moveHappened, proceed \rchanset \rpar Mapping) \\
	\t2 {} \circhide \lchanset \\
	\t2 getRobotPosition, getRobotVelocity, getRobotAcceleration, \\
	\t2 getRobotOrientation, getRobotAngularVelocity, getRobotAngularAcceleration, \\
	\t2 setRobotPosition, setRobotVelocity, setRobotAcceleration, \\
	\t2 setRobotOrientation, setRobotAngularVelocity, setRobotAngularAcceleration, \\
	\t2 getMaxObstacleID, getObstaclePosition, getObstacleOrientation, moveHappened, proceed \rchanset
\end{circus}