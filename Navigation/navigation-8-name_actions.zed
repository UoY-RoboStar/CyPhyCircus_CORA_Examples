\documentclass{article}

\usepackage[cm]{fullpage}
\usepackage{circus}
\usepackage{comment}

\input{roboworld.tex}

\begin{document}
\begin{comment}
\begin{zsection}
  \SECTION turtlebot \parents roboworld\_2d\_toolkit
\end{zsection}
\end{comment}

\begin{axdef}
	eps : \real
\end{axdef}

\section{Types}

% The arena is two-dimensional.
\begin{zed}
	Position ~==~ \real \cross \real \\
	Velocity ~==~ \real \cross \real \\
	Acceleration ~==~ \real \cross \real \\
	Orientation ~==~ \real \\
	AngularVelocity ~==~ \real \\
	AngularAcceleration ~==~ \real
\end{zed}

\begin{schema}{ArenaProperty}
	% The arena is two-dimensional.
	xwidth, ywidth : \real \\
	gradient, windSpeed : \real \\
	locations : \power Position
\where
	% The arena is two-dimensional.
	locations = \{ x : 0 \upto xwidth; y : 0 \upto ywidth \}
\end{schema}

% The robot is a point mass.
\begin{schema}{RobotProperty}
	position : Position \\
	velocity : Velocity \\
	acceleration : Acceleration \\
	orientation : Orientation \\
	angularVelocity : AngularVelocity \\
	angularAcceleration : AngularAcceleration
\end{schema}

% The arena has obstacles.
\begin{zed}
	[ObstacleID]
\end{zed}
\begin{schema}{ObstacleProperty}
	% The obstacles are circles.
	radius : \real \\
	position : Position \\
	orientation : Orientation \\
	locations : \power Position
\where
	% The obstacles are circles.
	locations = circleLocs~position~orientation~radius
\end{schema}

\section{Channels}

\subsection{Software channels}

\begin{zed}
	InOut ::= in | out
\end{zed}
\begin{circus}
	\circchannel obstacle : InOut \cross \real \\
	\circchannel moveToLocationCall : \real \cross \real
\end{circus}

\begin{circus}
	\circchannel tock
\end{circus}
\begin{axdef}
	tockLength : \real
\end{axdef}

\subsection{Input event triggered channels}

\begin{circus}
	\circchannel obstacleTriggered : \boolean \cross \real
\end{circus}

\subsection{Output clock reset channels}

\begin{circus}
	\circchannel moveToLocationHappened
\end{circus}

\subsection{Variable get/set channels}

\begin{circus}
	\circchannel getRobotPosition : Position \\
	\circchannel getRobotVelocity : Velocity \\
	\circchannel getRobotAcceleration : Acceleration \\
	\circchannel getRobotOrientation : Orientation \\
	\circchannel getRobotAngularVelocity : AngularVelocity \\
	\circchannel getRobotAngularAcceleration : AngularAcceleration \\
	\circchannel setRobotPosition : Position \\
	\circchannel setRobotVelocity : Velocity \\
	\circchannel setRobotAcceleration : Acceleration \\
	\circchannel setRobotOrientation : Orientation \\
	\circchannel setRobotAngularVelocity : AngularVelocity \\
	\circchannel setRobotAngularAcceleration : AngularAcceleration
\end{circus}

\begin{circus}
	\circchannel getMaxObstacleID : \nat \\
	\circchannel getObstaclePosition : ObstacleID \cross Position \\
	\circchannel getObstacleOrientation : ObstacleID \cross Orientation
\end{circus}

\begin{circus}
	\circchannel proceed
\end{circus}

\section{Global Constants}

\begin{axdef}
	arena : ArenaProperty \\ % arena is a region, so is static
	obstacles : ObstacleID \fun ObstacleProperty % obstacles are multiple and static
\end{axdef}

% The arena has a floor.
% no need for ground locations set in 2d

\begin{axdef}
\where
	arena.gradient = 0\decimalpoint0 % The gradient of the ground is 0.0.
\end{axdef}

\begin{axdef}
\where
	\# obstacles \geq 2 \\ % The arena has at least 2 obstacles.
	\forall obstacle : \ran obstacles @ obstacle.locations \subseteq arena.locations
\end{axdef}

\section{Environment}

\begin{axdef}
	timeStep : \real
\end{axdef}

\begin{circus}
	\circprocess Environment \circdef \circbegin
\end{circus}

\subsection{Environment State}

\begin{schema}{InputEventTimes}
	obstacleTime : \real \\
	obstacleOccurred : \boolean
\end{schema}
\begin{schema}{InputEventTimesInit}
	InputEventTimes~'
\where
	obstacleTime' = 0\decimalpoint0 \\
	obstacleOccurred' = \false
\end{schema}

\begin{schema}{OutputEventTimes}
	moveToLocationTime : \real \\
	moveToLocationOccurred : \boolean
\end{schema}
\begin{schema}{OutputEventTimesInit}
	OutputEventTimes~'
\where
	moveToLocationTime' = 0\decimalpoint0 \\
	moveToLocationOccurred' = \false
\end{schema}

\circtoolsoff
\begin{schema}{EnvironmentStateVars}
	\mathbf{visible}\; robot : RobotProperty \\
	time : \real \\
	stepTimer : \real \\
	tockTimer : \real \\
	InputEventTimes \\
	OutputEventTimes
\where
	robot.position \in arena.locations
\end{schema}
\circtoolson
\begin{comment}
\begin{schema}{EnvironmentStateVars}
	robot : RobotProperty \\
	time : \real \\
	stepTimer : \real \\
	tockTimer : \real \\
	InputEventTimes \\
	OutputEventTimes
\end{schema}
\end{comment}

\begin{schema}{RobotAssumptions}
	EnvironmentStateVars
\where
	robot.position \in arena.locations
\end{schema}

\begin{schema}{RobotCollisionAssumptions}
	EnvironmentStateVars
\where
	\forall obstacle : \ran obstacles @ robot.position \notin obstacle.locations
\end{schema}

\begin{schema}{EnvironmentState}
	EnvironmentStateVars \\
	value : Orientation \\
	inarg1 : \real \\
	inarg2 : \real \cross \real \\
	inarg3 : \real \cross \real \\
	inarg4 : \real \cross \real \\
	inarg5 : \real \\
	inarg6 : \real \\
	inarg7 : \real \\
	inarg8 : ObstacleID \\
	inarg9 : ObstacleID \\
	obstacleTrig : \boolean \\
	params : \real \\
	inarg10 : \boolean \\
	inarg11 : \real
\where
	RobotAssumptions \\
	RobotCollisionAssumptions
\end{schema}
\begin{circusaction}
	\circstate EnvironmentState
\end{circusaction}

\begin{schema}{EnvironmentLoopStateInit}
	\exists OutputEventTimes~' @ EnvironmentState~' 
\where
	time' = 0\decimalpoint0 \\
	stepTimer' = 0\decimalpoint0 \\
	tockTimer' = 0\decimalpoint0 \\
	InputEventTimesInit
\end{schema}

\subsection{Robot Movement}

\circtoolsoff
\begin{schema}{RobotMovement}
	\Lambda EnvironmentState
\where
	\derivative{robot.position} = robot.velocity \\
	\derivative{robot.velocity} = robot.acceleration \\
	\derivative{robot.acceleration} = (0,0) \\
	\derivative{robot.orientation} = robot.angularVelocity \\
	\derivative{robot.angularVelocity} = robot.angularAcceleration \\
	\derivative{robot.angularAcceleration} = 0 \\
	\derivative{time} = 1 \\
	\derivative{stepTimer} = 1 \\
	\derivative{tockTimer} = 1
\end{schema}
\circtoolson
\begin{comment}
\begin{schema}{RobotMovement}
	\Delta EnvironmentState
\where
	\derivative{robot.position} = robot.velocity \\
	\derivative{robot.velocity} = robot.acceleration \\
	\derivative{robot.acceleration} = (0,0) \\
	\derivative{robot.orientation} = robot.angularVelocity \\
	\derivative{robot.angularVelocity} = robot.angularAcceleration \\
	\derivative{robot.angularAcceleration} = 0 \\
	\derivative{time} = 1 \\
	\derivative{stepTimer} = 1 \\ 
	\derivative{tockTimer} = 1
\end{schema}
\end{comment}

\begin{zed}
	\relation (robotObstacleCollision \varg)
\end{zed}
\begin{axdef}
	robotObstacleCollision \varg : \power (RobotProperty \cross ObstacleProperty)
\where
	\forall robot : RobotProperty; obstacle : ObstacleProperty @ \\
	\t1 robotObstacleCollision~(robot, obstacle) \iff robot.position \in obstacle.locations
\end{axdef}

\circtoolsoff
\begin{circusaction}
	RobotMovementAction\_1 \circdef \lschexpract RobotMovement \rschexpract \\
	\t1 \circinterrupt \circblockbegin
			% collision between robot and an obstacle
			\exists obstacle : \ran obstacles @ robotObstacleCollision(robot, obstacle) \\
			\t2 {} \land (robot.velocity \vecdotprod (obstacle.position \vecminus robot.position) > 0)) \\
			% timeStep reached
			{} \lor (stepTimer \geq timeStep)
		\circblockend
\end{circusaction}
\circtoolson
\begin{comment}
\begin{circusaction}
	RobotMovementAction\_1 \circdef \lschexpract RobotMovement \rschexpract \circseq
	\lcircguard \circblockbegin
			% collision between robot and an obstacle
			\exists obstacle : \ran obstacles @ robotObstacleCollision(robot, obstacle) \\
			% timeStep reached
			{} \lor (stepTimer \geq timeStep)
		\circblockend \rcircguard \circguard \Skip
\end{circusaction}
\end{comment}

\subsection{Collision Detection}

\begin{axdef}
	collisionEps : \real
\end{axdef}
\begin{comment}
\begin{circusaction}
	HandleCollision \circdef \\
	\lschexpract [ \Delta EnvironmentState | 
	\t1 robot'.position = \\
	\t2 robot.position \vecminus {} \\
	\t3 (collisionEps \realdiv 2) \scalarmult  (2 \scalarmult robot.velocity \vecminus collisionEps \scalarmult robot.acceleration) \land \\
	\t1 robot.velocity = robot.velocity \vecminus collisionEps \scalarmult robot.acceleration ] \rschexpract
\end{circusaction}
\end{comment}
\circtoolsoff
\begin{circusaction}
	HandleCollision \circdef \\
	\t1 robot.position, robot.velocity := \\
	\t2 robot.position \vecminus {} \\
	\t3 (collisionEps \realdiv 2) \scalarmult  (2 \scalarmult robot.velocity \vecminus collisionEps \scalarmult robot.acceleration), \\
	\t2 robot.velocity \vecminus collisionEps \scalarmult robot.acceleration \\ 
\end{circusaction}
\circtoolson

\subsection{Input Triggers}

\begin{circusaction}
	InputTriggers\_1 \circdef obstacle\_InputEventMapping\_1
\end{circusaction}


% When the distance from the robot to an obstacle is less than 0.5 m, 
% the event obstacle occurs and it communicates the orientation towards the nearest obstacle.
\begin{schema}{obstacle\_InputEventMapping\_DetermineValue}
	\Xi EnvironmentState \\
	value! : Orientation
\where
	\exists obs1 : \ran obstacles | \\
	\t1 (\forall obs2 : \ran obstacles @ norm(obs1.position \vecminus robot.position) \leq norm(obs2.position \vecminus robot.position)) @ \\
	\t1 value! = vectorToOrientation~(obs1.position \vecminus robot.position)
\end{schema}
\begin{circusaction}
	obstacle\_InputEventMapping\_1 \circdef \\
	\t1 \circif (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5 - eps)) \circthen obstacle\_InputEventMapping\_2 \\
	\t1 \t1 {} \circelse \lnot (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5)) \circthen obstacle\_InputEventMapping\_3 \\
	\t1 {} \circelse \lnot (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5 - eps)) \\
	\t2 {} \land (\exists obstacle1 : \ran obstacles @ \exists loc : obstacle1.locations @ \\
	\t2 (norm~(loc \vecminus robot.position) < 0\decimalpoint5)) \circthen {} \\
	\t3 obstacle\_InputEventMapping\_4 \\
	\t1 \circfi \\
	obstacle\_InputEventMapping\_2 \circdef \\
	\t1 obstacle\_InputEventMapping\_5 \circseq obstacle\_InputEventMapping\_6 \\
	obstacle\_InputEventMapping\_3 \circdef \\
	\t1 obstacleTriggered!\false?x \then inarg1 := x \circseq obstacle\_InputEventMapping\_7 \\
	obstacle\_InputEventMapping\_4 \circdef \Skip \\
	obstacle\_InputEventMapping\_5 \circdef \lschexpract obstacle\_InputEventMapping\_DetermineValue \rschexpract \\
	obstacle\_InputEventMapping\_6 \circdef obstacleTriggered!\true!value \then obstacle\_InputEventMapping\_8 \\
	obstacle\_InputEventMapping\_7 \circdef \Skip \\
	obstacle\_InputEventMapping\_8 \circdef obstacleOccurred, obstacleTime := \true, time
\end{circusaction}

\subsection{Communication with Mapping Definitions}

\begin{circusaction}
	Communication\_1 \circdef \\
	\t1 getRobotPosition!(robot.position) \then Communication\_2 \\
	\t1 {} \extchoice {} \\
	\t1 getRobotVelocity!(robot.velocity) \then Communication\_3 \\
	\t1 {} \extchoice {} \\
	\t1 getRobotAcceleration!(robot.acceleration) \then Communication\_4 \\
	\t1 {} \extchoice {} \\
	\t1 getRobotOrientation!(robot.orientation) \then Communication\_5 \\
	\t1 {} \extchoice {} \\
	\t1 getRobotAngularVelocity!(robot.angularVelocity) \then Communication\_6 \\
	\t1 {} \extchoice {} \\
	\t1 getRobotAngularAcceleration!(robot.angularAcceleration) \then Communication\_7 \\
	\t1 {} \extchoice {} \\
	\t1 setRobotPosition?x \then inarg2 := x \circseq Communication\_8 \\
	\t1 {} \extchoice {} \\
	\t1 setRobotVelocity?x \then inarg3 := x \circseq Communication\_9 \\
	\t1 {} \extchoice {} \\
	\t1 setRobotAcceleration?x \then inarg4 := x \circseq Communication\_10 \\
	\t1 {} \extchoice {} \\
	\t1 setRobotOrientation?x \then inarg5 := x \circseq Communication\_11 \\
	\t1 {} \extchoice {} \\
	\t1 setRobotAngularVelocity?x \then inarg6 := x \circseq Communication\_12 \\
	\t1 {} \extchoice {} \\
	\t1 setRobotAngularAcceleration?x \then inarg7 := x \circseq Communication\_13 \\
	\t1 {} \extchoice {} \\
	\t1 getMaxObstacleID!(\# obstacles) \then Communication\_14 \\
	\t1 {} \extchoice {} \\
	\t1 getObstaclePosition?o!((obstacles~o).position) \then inarg8 := o \circseq Communication\_15 \\
	\t1 {} \extchoice {} \\
	\t1 getObstacleOrientation?o!((obstacles~o).orientation) \then inarg9 := o \circseq Communication\_16 \\
	\t1 {} \extchoice proceed \then Communication\_17 \\
	Communication\_2 \circdef Communication\_18 \circseq Communication\_1 \\
	Communication\_3 \circdef Communication\_19 \circseq Communication\_1 \\
	Communication\_4 \circdef Communication\_20 \circseq Communication\_1 \\
	Communication\_5 \circdef Communication\_21 \circseq Communication\_1 \\
	Communication\_6 \circdef Communication\_22 \circseq Communication\_1 \\
	Communication\_7 \circdef Communication\_23 \circseq Communication\_1 \\
	Communication\_8 \circdef Communication\_24 \circseq Communication\_1 \\
	Communication\_9 \circdef Communication\_25 \circseq Communication\_1 \\
	Communication\_10 \circdef Communication\_26 \circseq Communication\_1 \\
	Communication\_11 \circdef Communication\_27 \circseq Communication\_1 \\
	Communication\_12 \circdef Communication\_28 \circseq Communication\_1 \\
	Communication\_13 \circdef Communication\_29 \circseq Communication\_1 \\
	Communication\_14 \circdef Communication\_30 \circseq Communication\_1 \\
	Communication\_15 \circdef Communication\_31 \circseq Communication\_1 \\
	Communication\_16 \circdef Communication\_32 \circseq Communication\_1 \\
	Communication\_17 \circdef \Skip \\
	Communication\_18 \circdef \Skip \\
	Communication\_19 \circdef \Skip \\
	Communication\_20 \circdef \Skip \\
	Communication\_21 \circdef \Skip \\
	Communication\_22 \circdef \Skip \\
	Communication\_23 \circdef \Skip
\end{circusaction}
\circtoolsoff
\begin{circusaction}
	Communication\_24 \circdef robot.position := inarg2 \\
	Communication\_25 \circdef robot.velocity := inarg3 \\
	Communication\_26 \circdef robot.acceleration := inarg4 \\
	Communication\_27 \circdef robot.orientation := inarg5 \\
	Communication\_28 \circdef robot.angularVelocity := inarg6 \\
	Communication\_29 \circdef robot.angularAcceleration := inarg7
\end{circusaction}
\circtoolson
\begin{comment}
\begin{circusaction}
	Communication\_24 \circdef inarg2 := inarg2 \\
	Communication\_25 \circdef inarg3 := inarg3 \\
	Communication\_26 \circdef inarg4 := inarg4 \\
	Communication\_27 \circdef inarg5 := inarg5 \\
	Communication\_28 \circdef inarg6 := inarg6 \\
	Communication\_29 \circdef inarg7 := inarg7
\end{circusaction}
\end{comment}
\begin{circusaction}
	Communication\_30 \circdef \Skip \\
	Communication\_31 \circdef \Skip \\
	Communication\_32 \circdef \Skip
\end{circusaction}

\begin{circusaction}
	CheckTock\_1 \circdef \\
	\t1 \circif tockTimer \geq tockLength - eps \circthen CheckTock\_2 \\
	\t1 {} \circelse tockTimer < tockLength - eps \circthen CheckTock\_3 \\
	\t1 \circfi \\
	CheckTock\_2 \circdef tock \then CheckTock\_4 \\
	CheckTock\_3 \circdef \Skip \\
	CheckTock\_4 \circdef tockTimer := 0\decimalpoint0 \\
\end{circusaction}

\subsubsection{Input Event Buffers}

\begin{circusaction}
	InputEventBuffers\_1 \circdef obstacle\_Buffer\_1
\end{circusaction}

\begin{circusaction}
	obstacle\_Buffer\_1 \circdef obstacle\_Buffer\_2 \circseq obstacle\_Buffer\_3 \\
	obstacle\_Buffer\_2 \circdef obstacleTrig := \false \\
	obstacle\_Buffer\_3 \circdef \\
	\t1 \circif obstacleTrig = \true \circthen obstacle\_Buffer\_4 \\
	\t1 \circelse obstacleTrig \neq \true \circthen obstacle\_Buffer\_5 \\
	\t1 \circfi \\
	obstacle\_Buffer\_4 \circdef \\
	\t1 obstacleTriggered?b?x \then inarg10, inarg11 := b, x \circseq obstacle\_Buffer\_6 \\
	\t1 {} \extchoice {} \\
	\t1 obstacle.in.params \then obstacle\_Buffer\_7 \\
	obstacle\_Buffer\_5 \circdef obstacleTriggered?b?x \then inarg10, inarg11 := b, x \circseq obstacle\_Buffer\_8 \\
	obstacle\_Buffer\_6 \circdef obstacle\_Buffer\_9 \circseq obstacle\_Buffer\_3 \\
	obstacle\_Buffer\_7 \circdef obstacle\_Buffer\_10 \circseq obstacle\_Buffer\_3 \\
	obstacle\_Buffer\_8 \circdef obstacle\_Buffer\_11 \circseq obstacle\_Buffer\_3 \\
	obstacle\_Buffer\_9 \circdef obstacleTrig, params := inarg10, inarg11 \\
	obstacle\_Buffer\_10 \circdef \Skip \\
	obstacle\_Buffer\_11 \circdef obstacleTrig, params := inarg10, inarg11 \\
\end{circusaction}

\subsection{Output Event Buffers}

\begin{circusaction}
	OutputEventBuffers\_1 \circdef moveToLocation\_Buffer\_1
\end{circusaction}

\begin{circusaction}
	moveToLocation\_Buffer\_1 \circdef moveToLocation\_Buffer\_2 \circseq moveToLocation\_Buffer\_3 \\
	moveToLocation\_Buffer\_2 \circdef \lschexpract OutputEventTimesInit \rschexpract \\
	moveToLocation\_Buffer\_3 \circdef moveToLocationHappened \then moveToLocation\_Buffer\_4 \\
	moveToLocation\_Buffer\_4 \circdef moveToLocation\_Buffer\_5 \circseq moveToLocation\_Buffer\_1 \\
	moveToLocation\_Buffer\_5 \circdef moveToLocationOccurred, moveToLocationTime := \true, time
\end{circusaction}

\subsection{Environment main action}

\begin{circusaction}
	EventBuffers\_1 \circdef InputEventBuffers\_1 \lpar \{ obstacleTrig, params, inarg10, inarg11 \} | \emptyset | \{ moveToLocationTime, moveToLocationOccurred \} \rpar OutputEventBuffers\_1
\end{circusaction}

\begin{circusaction}
	EnvironmentLoop\_1 \circdef EnvironmentLoop\_2 \circseq EnvironmentLoop\_3 \\
	EnvironmentLoop\_2 \circdef \lschexpract\ EnvironmentLoopStateInit \rschexpract \\
	EnvironmentLoop\_3 \circdef RobotMovementAction\_1 \circseq EnvironmentLoop\_4 \\
	EnvironmentLoop\_4 \circdef EnvironmentLoop\_5 \circseq EnvironmentLoop\_3 \\
	EnvironmentLoop\_5 \circdef \\
	\t1 \circif stepTimer < timeStep - eps \circthen HandleCollision \\
	\t1 {} \circelse stepTimer \geq timeStep - eps \circthen EnvironmentLoop\_6 \\
	\t1 \circfi \\
	EnvironmentLoop\_6 \circdef InputTriggers\_1 \circseq EnvironmentLoop\_7 \\
	EnvironmentLoop\_7 \circdef Communication\_1 \circseq EnvironmentLoop\_8 \\
	EnvironmentLoop\_8 \circdef CheckTock\_1 \circseq EnvironmentLoop\_9 \\
	EnvironmentLoop\_9 \circdef stepTimer := 0
\end{circusaction}

\begin{circusaction}
	\circspot (EnvironmentLoop\_1 \lpar \{ robot, time, stepTimer, obstacleTime, obstacleOccurred, value, inarg1, inarg2, inarg3, inarg4, inarg5, inarg6, inarg7, inarg8, inarg9 \} | \lchanset obstacleTriggered \rchanset | \{ moveToLocationTime, moveToLocationOccurred, obstacleTrig, params, inarg10, inarg11 \} \rpar EventBuffers\_1) \\
	\t1 \circhide \lchanset obstacleTriggered \rchanset
\end{circusaction}

\begin{circus}
	\circend
\end{circus}

% When the operation moveToLocation(pos) is called,
% the orientation of the robot is set to the orientation towards the pos
% and the velocity of the robot is set to 1.0 m/s towards the pos.
\begin{circus}
	\circprocess moveToLocation\_OperationMapping \circdef \circbegin
\end{circus}
\begin{circusaction}
	\circstate [ \\
	\t1 inarg12 : \real \cross \real \\
	\t1 inarg13 : \real \cross \real \\
	\t1 inarg14 : \real \cross \real]
\end{circusaction}
\begin{circusaction}
	moveToLocation\_Semantics\_1 \circdef \\
	\t1 moveToLocationCall?x \then inarg12 := x \circseq moveToLocation\_Semantics\_2 \\
	\t1 {} \extchoice {} \\
	\t1 proceed \then moveToLocation\_Semantics\_1 \\
	moveToLocation\_Semantics\_2 \circdef getRobotPosition?x \then inarg13 := x \circseq moveToLocation\_Semantics\_3 \\
	moveToLocation\_Semantics\_3 \circdef moveToLocation\_Semantics\_4 \circseq moveToLocation\_Semantics\_1 \\
	moveToLocation\_Semantics\_4 \circdef setRobotOrientation!(vectorToOrientation~(towards~inarg13~inarg12)) \then moveToLocation\_Semantics\_5 \\
	moveToLocation\_Semantics\_5 \circdef moveToLocation\_Semantics\_6 \circseq moveToLocation\_Semantics\_7 \\
	moveToLocation\_Semantics\_6 \circdef \Skip \\
	moveToLocation\_Semantics\_7 \circdef setRobotVelocity!(1\decimalpoint0 \scalarmult (towards~inarg13~inarg12)) \then moveToLocation\_Semantics\_8 \\
	moveToLocation\_Semantics\_8 \circdef \Skip
\end{circusaction}
\begin{circusaction}
	moveToLocation\_Monitor\_1 \circdef moveToLocationCall?x \then inarg14 := x \circseq moveToLocation\_Monitor\_2 \\
	moveToLocation\_Monitor\_2 \circdef moveToLocationHappened \then moveToLocation\_Monitor\_1
\end{circusaction}
\begin{circusaction}
	\circspot moveToLocation\_Semantics\_1 \lpar \{ inarg12, inarg13 \} | \lchanset moveToLocationCall \rchanset | \{ inarg14 \} \rpar moveToLocation\_Monitor\_1
\end{circusaction}
\begin{circus}
	\circend
\end{circus}

\begin{circus}
	\circprocess Mapping \circdef moveToLocation\_OperationMapping
\end{circus}

\section{Composition}

\begin{circus}
	\circprocess RoboWorldDocument \circdef \\
	\t1 (Environment \lpar \lchanset \\
	\t2 getRobotPosition, getRobotVelocity, getRobotAcceleration, \\
	\t2 getRobotOrientation, getRobotAngularVelocity, getRobotAngularAcceleration, \\
	\t2 setRobotPosition, setRobotVelocity, setRobotAcceleration, \\
	\t2 setRobotOrientation, setRobotAngularVelocity, setRobotAngularAcceleration, \\
	\t2 getMaxObstacleID, getObstaclePosition, getObstacleOrientation, \\
	\t2 moveToLocationHappened, proceed \rchanset \\
	\t1 \rpar Mapping) \\
	\t2 {} \circhide \lchanset \\
	\t3 getRobotPosition, getRobotVelocity, getRobotAcceleration, \\
	\t3 getRobotOrientation, getRobotAngularVelocity, getRobotAngularAcceleration, \\
	\t3 setRobotPosition, setRobotVelocity, setRobotAcceleration, \\
	\t3 setRobotOrientation, setRobotAngularVelocity, setRobotAngularAcceleration, \\
	\t3 getMaxObstacleID, getObstaclePosition, getObstacleOrientation, \\
	\t1 moveToLocationHappened, proceed \rchanset
\end{circus}

